{
  "name": "big-data-viz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc && vite build",
    "build:demo": "tsc && vite build --mode demo",
    "demo:verify": "node scripts/verify-demo-package.mjs",
    "preview": "vite preview",
    "incident:new": "node scripts/new-incident.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:structure": "node scripts/check-feature-structure.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "test": "jest",
    "test:contracts": "jest src/lib/contracts.test.ts --runInBand",
    "test:perf": "pnpm run build && node scripts/check-performance.mjs",
    "test:release-governance": "node scripts/check-release-governance.mjs",
    "test:reliability": "node scripts/check-reliability.mjs",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "SKIP_RENDER_PERF=1 playwright test",
    "test:e2e:auth": "PW_AUTH_SUITE=1 playwright test",
    "prepare": "husky",
    "check:env": "node scripts/check-env.mjs",
    "test:security-headers": "node scripts/check-security-headers.mjs",
    "test:dependency-policy": "node scripts/check-dependency-policy.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "quality:dashboard": "node scripts/generate-quality-dashboard.mjs",
    "test:render-perf": "playwright test tests/e2e/render-performance.e2e.spec.ts --workers=1",
    "test:e2e:a11y": "playwright test tests/e2e/a11y.e2e.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@swc/core": "^1.15.30",
    "@swc/jest": "^0.2.38",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.9",
    "vite-plugin-checker": "^0.13.0"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.1",
    "@deck.gl/layers": "^9.3.1",
    "@deck.gl/react": "^9.3.1",
    "@react-sigma/core": "^5.0.6",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-virtual": "^3.13.24",
    "d3": "^7.9.0",
    "echarts": "^6.0.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "html-to-image": "^1.11.13",
    "msw": "^2.13.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-error-boundary": "^6.1.1",
    "react-intl": "^10.1.2",
    "react-router-dom": "^7.14.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
